{
  "$schema": "https://opencode.ai/config.json",
  "model": "explabs/gpt-6-astra",
  "provider": {
    "explabs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Experiential Labs",
      "options": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{env:EXPLABS_API_KEY}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "qwen3.8-27b": {
          "name": "Qwen 3.8 27B"
        }
      }
    }
  }
}
